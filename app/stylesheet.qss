QWidget {
    background-color: {colors.background};
    border-color: {colors.border};
    color: {colors.text};
}

QFrame {
    border-color: {colors.border};
}

#topMenu {
    min-height: 160px;
    max-height: 160px;
}

#browserFrame {
    min-width: 250px;
    max-width: 400px;
}

#editorTab {
    min-width: 250px;
    max-width: 400px;
}

#centralTab {
    min-width: 400px;
}

QMenuBar {
    background-color: {colors.surface};
    color: {colors.text};
    border-bottom: 1px solid {colors.border};
}
QMenuBar::item {
    padding: 4px 8px;
    text-align: center;
}
QMenuBar::item:selected {
    background-color: {colors.button-hover};
    color: {colors.text};
}
QMenu::item {
    padding: 4px 20px;
    text-align: center;
    width: 100%;
}

QMenu {
    background-color: {colors.surface};
    color: {colors.text};
}
QMenu::item:selected {
    background-color: {colors.button-hover};
    color: {colors.text};
}

QToolBar {
    background-color: {colors.surface};
}
QToolButton {
    background-color: {colors.input-background};
    border: 1px solid {colors.border};
    border-radius: 4px;
    min-height: 14px;
    padding: 4px 8px;
}
QToolButton:hover {
    background-color: {colors.button-hover};
}

QStatusBar {
    background-color: {colors.surface};
    color: {colors.text};
    border-top: 1px solid {colors.border};
}

QTabWidget::pane {
    background-color: {colors.surface};
    border: 1px solid {colors.border};
    border-radius: 4px;
}
QTabBar::tab {
    background-color: {colors.surface};
    color: {colors.text};
}
QTabBar::tab:selected {
    background-color: {colors.background};
    color: {colors.text};
}
QTabBar::tab:!selected {
    background-color: {colors.surface};
    color: {colors.text};
}

QScrollBar:vertical {
    background-color: {colors.surface};
}
QScrollBar::handle:vertical {
    background-color: {colors.button};
}
QScrollBar::handle:vertical:hover {
    background-color: {colors.button-hover};
}
QScrollBar:horizontal {
    background-color: {colors.surface};
}
QScrollBar::handle:horizontal {
    background-color: {colors.button};
}
QScrollBar::handle:horizontal:hover {
    background-color: {colors.button-hover};
}

QCheckBox, QRadioButton {
    background-color: "transparent";
}

QCheckBox::indicator {
    background-color: "{colors.surface}";
    border: 1px solid {colors.border};
}
QCheckBox::indicator:checked {
    background-color: {colors.primary};
    border-color: {colors.primary};
}
QRadioButton::indicator {
    background-color: {colors.surface};
    border: 1px solid {colors.border};
    border-radius: 4px;
    width: 8px;
    height: 8px;
    min-width: 8px;
    min-height: 8px;
    max-width: 8px;
    max-height: 8px;
}
QRadioButton::indicator:checked {
    background-color: {colors.primary};
    border-color: {colors.primary};
}

QComboBox {
    background-color: {colors.input-background};
    color: {colors.text};
    border: 1px solid {colors.border};
    border-radius: 4px;
    padding: 6px 0px 6px 12px;
    min-height: 10px;
    min-width: 60px;
}
QComboBox:hover {
    border-color: {colors.primary};
    background-color: {colors.surface};
}
QComboBox:focus {
    border-color: {colors.primary};
    background-color: {colors.input-background};
}
QComboBox:disabled {
    background-color: {colors.disabled};
    color: {colors.text-disabled};
    border-color: {colors.border};
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    background: transparent;
}
QComboBox::drop-down:hover {
    background-color: {colors.button-hover};
}
QComboBox QAbstractItemView::item {
    padding: 2px 16px;
}
QComboBox::drop-down:pressed {
    background-color: {colors.button-pressed};
}
QComboBox::down-arrow {
    image: url({images.arrow-down});
    width: 26px;
    height: 24px;
    padding: 5px;
}
QComboBox::down-arrow:disabled {
    opacity: 0.5;
}
QComboBox QAbstractItemView {
    background-color: {colors.surface};
    color: {colors.text};
    border: 1px solid {colors.border};
    border-radius: 4px;
    selection-background-color: {colors.selection-background};
    selection-color: {colors.selection-text};
    outline: none;
    min-width: 100px;
}
QComboBox QAbstractItemView::item {
    padding: 2px 16px;
    border-radius: 4px;
    min-height: 24px;
    background-color: {colors.input-background};
}
QComboBox QAbstractItemView::item:hover {
    background-color: {colors.button-hover};
}
QComboBox QAbstractItemView::item:selected {
    background-color: {colors.selection-background};
    color: {colors.selection-text};
}

QSlider::groove:horizontal {
    background-color: {colors.surface};
}
QSlider::handle:horizontal {
    background-color: {colors.primary};
}
QSlider::groove:vertical {
    background-color: {colors.surface};
}
QSlider::handle:vertical {
    background-color: {colors.primary};
}

QProgressBar {
    background-color: {colors.surface};
    color: {colors.text};
}
QProgressBar::chunk {
    background-color: {colors.primary};
}

QListView {
    background-color: {colors.surface};
    color: {colors.text};
    selection-background-color: {colors.selection-background};
    selection-color: {colors.selection-text};
}
QListView::item:hover {
    background-color: {colors.button-hover};
}
QListView::item:selected {
    background-color: {colors.selection-background};
    color: {colors.selection-text};
}

QGroupBox {
    background-color: {colors.surface};
}
QGroupBox:title {
    color: {colors.text};
}
QGroupBox QLabel {
    background-color: transparent;
}

QDialog {
    background-color: {colors.background};
    color: {colors.text};
}

QDateEdit, QTimeEdit {
    background-color: {colors.input-background};
    color: {colors.text};
}

QCalendarWidget QWidget {
    background-color: {colors.surface};
    color: {colors.text};
}
QCalendarWidget QAbstractItemView:enabled {
    background-color: {colors.surface};
    color: {colors.text};
    selection-background-color: {colors.button-hover};
    selection-color: {colors.text};
}

QToolTip {
    background-color: {colors.surface};
    color: {colors.text};
}

QPushButton {
    background-color: {colors.input-background};
    color: {colors.text};
    border: 1px solid {colors.border};
    border-radius: 4px;
    min-height: 14px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: {colors.button-hover};
}
QPushButton:pressed {
    background-color: {colors.button-pressed};
}
QPushButton:disabled {
    background-color: {colors.disabled};
    color: {colors.text-disabled};
}

QLineEdit {
    background-color: {colors.input-background};
    color: {colors.text};
    selection-background-color: {colors.selection-background};
    selection-color: {colors.selection-text};
}
QLineEdit:disabled {
    background-color: {colors.disabled};
    color: {colors.text-disabled};
}

QTextEdit, QPlainTextEdit {
    background-color: {colors.input-background};
    color: {colors.text};
    selection-background-color: {colors.selection-background};
    selection-color: {colors.selection-text};
}

QLabel {
    color: {colors.text};
}
QLabel:disabled {
    color: {colors.text-disabled};
}

QTreeView {
    background-color: {colors.surface};
    color: {colors.text};
    selection-background-color: {colors.selection-background};
    selection-color: {colors.selection-text};
}
QTreeView::item:hover {
    background-color: {colors.button-hover};
}
QTreeView::item:selected {
    background-color: {colors.selection-background};
    color: {colors.selection-text};
}
QTreeView::indicator:unchecked {
    background-color: {colors.surface};
    border-color: {colors.border};
}
QTreeView::indicator:checked {
    background-color: {colors.primary};
    border-color: {colors.primary};
}

QTableWidget, QTableView {
    background-color: {colors.input-background};
    color: {colors.text};
    gridline-color: {colors.border};
    selection-background-color: {colors.selection-background};
    selection-color: {colors.selection-text};
    border: 1px solid {colors.border};
    border-radius: 4px;
}
QTableWidget::item {
    padding: 0px;
}
QTableWidget::item:alternate {
    background-color: {colors.surface};
}
QTableWidget::item:hover, QTableView::item:hover {
    background-color: {colors.button-hover};
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: {colors.selection-background};
    color: {colors.selection-text};
}
QTableWidget::item:selected:alternate {
    background-color: {colors.selection-background};
}

QHeaderView::section {
    background-color: {colors.surface};
    color: {colors.text};
    border: none;
    border-bottom: 2px solid {colors.border};
    border-right: 1px solid {colors.border};
    padding: 8px;
    font-weight: bold;
}
QHeaderView::section:first {
    border-left: none;
}
QHeaderView::section:last {
    border-right: none;
}
QHeaderView::section:hover {
    background-color: {colors.button-hover};
}

QTableView QTableCornerButton::section {
    background-color: {colors.surface};
    border-bottom: 2px solid {colors.border};
}
QTableWidget QTableCornerButton::section {
    background-color: {colors.surface};
    border-bottom: 2px solid {colors.border};
}

QSpinBox, QDoubleSpinBox {
    background-color: {colors.input-background};
    color: {colors.text};
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: {colors.button};
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: {colors.button-hover};
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url({images.arrow-up});
    width: 16px;
    height: 16px;
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    opacity: 0.5;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: {colors.button};
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: {colors.button-hover};
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url({images.arrow-down});
    width: 16px;
    height: 16px;
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    opacity: 0.5;
}

QFontComboBox {
    background-color: {colors.input-background};
    color: {colors.text};
}
QFontComboBox QAbstractItemView {
    background-color: {colors.surface};
    color: {colors.text};
    selection-background-color: {colors.selection-background};
    selection-color: {colors.selection-text};
}

QGraphicsView {
    background-color: {colors.surface};
}

QGraphicsScene {
    background-color: {colors.surface};
}

#graph_frame {
    background-color: {colors.surface};
}

#box_system_label {
    background-color: {colors.surface};
    color: {colors.text};
}

#topMenu {
    border-bottom: 1px solid {colors.border};
    min-height: 160px;
    max-height: 160px;
}
#topMenu QPushButton, #topMenu QToolButton {
    width: 100%;
    min-width: 0;
    text-align: center;
}
QToolButton#surface_button {
    width: 100%;
    min-width: 0px;
    max-width: 16777215px;
}
#topMenu QGroupBox QToolButton {
    width: 100%;
}

#browserFrame {
    border-right: 1px solid {colors.border};
    min-width: 250px;
    max-width: 400px;
}

#centralTab {
    min-width: 400px;
}

#editorTab {
    border-left: 1px solid {colors.border};
    min-width: 250px;
    max-width: 400px;
}

QFrame[frameShape="5"] {
    border: 1px solid {colors.border};
}

#editor_frame {
    border: 1px solid {colors.border};
    border-radius: 4px;
}